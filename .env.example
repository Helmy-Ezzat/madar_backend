# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Telegram (GramJS)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_STRING_SESSION=your_string_session

# Groq AI
GROQ_API_KEY=your_groq_api_key

# CORS — comma-separated allowed origins (add localhost for dev)
ALLOWED_ORIGINS=https://madar-jobs.vercel.app,http://localhost:3000

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_BASE64=
