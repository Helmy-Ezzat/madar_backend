{
  "name": "madar-backend",
  "version": "1.0.0",
  "description": "Standalone Express.js + TypeScript backend for Madar job aggregator",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "scrape": "tsx src/scripts/runScraper.ts",
    "reprocess": "tsx src/scripts/reprocessJobs.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/scripts/migrateCompanies.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "groq-sdk": "^0.9.1",
    "helmet": "^8.3.0",
    "input": "^1.0.1",
    "mongoose": "^8.9.5",
    "node-cron": "^4.6.0",
    "telegram": "^2.26.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.11",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
